<Window x:Class="Atsumari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atsumari"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Content="Remove Exe" Click="Remove_Click" Margin="5, 10" Padding="10,5" />
            <Button Content="Add Exe" Click="Add_Click" Margin="5, 10" Padding="10,5" />
            <Button Content="Add Folder" Click="Add_Folder" Margin="5,10" Padding="10,5" />
            <Button Content="Launch Exe" Click="Launch_Click" Margin="5,10" Padding="10,5" />
        </StackPanel>
        <ListBox x:Name="ItemList" Grid.Row="1"  MouseDoubleClick="ItemList_MouseDoubleClick" SelectionMode="Extended">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
