<Window x:Class="Atsumari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atsumari"
        mc:Ignorable="d"
        Title="Atsumari" Height="720" Width="1280">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5,10"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs">
        <TabItem Header="Home">
            <local:LibraryChooserView x:Name="ChooserScreen"/>
        </TabItem>
        <TabItem Header="Library" IsEnabled="False" x:Name="LibraryTab">
            <local:LibraryView x:Name="LibraryScreen"/>
        </TabItem>
        <TabItem Header="Settings">
            <local:SettingsView x:Name="SettingsScreen"/>
        </TabItem>
    </TabControl>
</Window>
