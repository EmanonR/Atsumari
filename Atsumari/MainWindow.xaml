<Window x:Class="Atsumari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atsumari"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5,10"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <!-- Vertical Split, Topbar, Tabs -->
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Foreground="Gray" VerticalAlignment="Center" Text="Libraries goes here... not implemented yet" />
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Padding="15">
                <StackPanel>
                <TextBlock Foreground="Gray" Text="Collections here in future" />
                <TextBlock Foreground="Gray" Text="Unused for now" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Remove Exe" Click="Remove_Click" />
                        <Button Content="Remove All" Click="Remove_All" />
                        <Button Content="Add Exe" Click="Add_Click" />
                        <Button Content="Add Folder" Click="Add_Folder" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBox Padding="6,4" VerticalContentAlignment="Center" x:Name="FilterBox" TextChanged="FilterBox_TextChanged" />
                    <TextBlock Padding="6,4" VerticalAlignment="Center" Foreground="Gray" IsHitTestVisible="False" Text="Search...">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox Grid.Row="2" x:Name="ItemsListBox" SelectionChanged="ItemList_SelectionChanged"  MouseDoubleClick="ItemList_MouseDoubleClick" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="8,0,8,0"/>
                                <TextBlock Text="{Binding displayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1">
                    <TextBlock Foreground="Gray" Text="Status..." x:Name="ScanInfoBox" MinHeight="25" Padding="5"/>
                </Border>
            </Grid>
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                <StackPanel Orientation="Vertical">
                    <Image Source="{Binding SelectedItem.Icon, ElementName=ItemsListBox}" Width="80" Height="80" Margin="0,8,0,8"/>
                    <TextBlock Text="Item name:" Width="Auto" Margin="10,0"/>
                    <TextBox TextChanged="selectedItemInput_TextChanged" x:Name="selectedItemInput" Width="Auto" Margin="10,0"/>
                    <Button Content="Launch Exe" Click="Launch_Click" Margin="10,10,10,5" />
                    <Button Content="Open Directory" Click="OpenDirectory_Click" Margin="10,5,10,10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
