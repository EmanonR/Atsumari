<Window x:Class="Atsumari.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Atsumari"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- Vertical Split, Topbar, Tabs -->
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <Button Content="Remove Exe" Click="Remove_Click" Margin="5, 10" Padding="10,5" />
            <Button Content="Add Exe" Click="Add_Click" Margin="5, 10" Padding="10,5" />
            <Button Content="Add Folder" Click="Add_Folder" Margin="5,10" Padding="10,5" />
            <Button Content="Launch Exe" Click="Launch_Click" Margin="5,10" Padding="10,5" />
        </StackPanel>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical"  Grid.Column="1">
                <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" Width="Auto" Height="25" />
                <ListBox x:Name="ItemsListBox" SelectionChanged="ItemList_SelectionChanged"  MouseDoubleClick="ItemList_MouseDoubleClick" SelectionMode="Extended">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding displayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Column="2">
                <Image x:Name="selectedItemIcon" Width="80" Height="80" Margin="0,0,8,0"/>
                <TextBox TextChanged="selectedItemInput_TextChanged" x:Name="selectedItemInput" Text="Hello" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
